generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/client"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            Int                @id @default(autoincrement())
  nome          String
  email         String             @unique
  tema          String             @default("dark-orange")
  fotoPerfil    String?            @db.Text
  createdAt     DateTime           @default(now())
  senhaHash     String?
  casosCriados  CasoClinico[]
  disciplinas   Disciplina[]
  flashcards    Flashcard[]
  investigacoes InvestigacaoCaso[]
  movimentacoes Movimentacao[]
  questoes      Questao[]
  respostas       Resposta[]
  aulasEstado     AulaEstado[]
  aulasListas     AulaLista[]
  aulasNotas      AulaNota[]
  aulasMarcadores AulaMarcador[]
  aulasEstudo     AulaEstudoDiario[]
  aulaMeta        AulaMeta?
}

model Disciplina {
  id        Int       @id @default(autoincrement())
  nome      String
  createdAt DateTime  @default(now())
  usuarioId Int
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questoes  Questao[]
}

model Questao {
  id           Int           @id @default(autoincrement())
  enunciado    String
  explicacao   String?
  createdAt    DateTime      @default(now())
  usuarioId    Int
  disciplinaId Int
  dificuldade  String?
  tema         String?
  fonte        String?
  origemId     String?
  banca        String?
  ano          Int?
  cargo        String?
  orgao        String?
  fonteUrl     String?
  imagemUrl    String?        @db.Text
  imagemAlt    String?
  alternativas Alternativa[]
  disciplina   Disciplina    @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  respostas    Resposta[]
  flashcards   Flashcard[]

  @@index([usuarioId, fonte, origemId])
  @@index([fonte])
  @@index([banca])
  @@index([ano])
}

model Alternativa {
  id        Int     @id @default(autoincrement())
  texto     String
  correta   Boolean @default(false)
  questaoId Int
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Cascade)
}

model Resposta {
  id           Int      @id @default(autoincrement())
  correta      Boolean
  respondidaAt DateTime @default(now())
  usuarioId    Int
  questaoId    Int
  questao      Questao  @relation(fields: [questaoId], references: [id], onDelete: Cascade)
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model Flashcard {
  id          Int      @id @default(autoincrement())
  frente      String
  verso       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  usuarioId   Int
  questaoId   Int?
  origem      String   @default("manual")
  tema        String?
  disciplina  String?
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  questao     Questao? @relation(fields: [questaoId], references: [id], onDelete: Cascade)
}

model Movimentacao {
  id        Int              @id @default(autoincrement())
  descricao String
  valor     Decimal          @db.Decimal(10, 2)
  tipo      TipoMovimentacao
  data      DateTime         @default(now())
  quitada   Boolean          @default(false)
  quitadaEm DateTime?
  createdAt DateTime         @default(now())
  usuarioId Int
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model CasoClinico {
  id                       Int                @id @default(autoincrement())
  titulo                   String
  area                     String
  especialidade            String?
  dificuldade              String
  cenario                  String
  queixaInicial            String
  /// *
  ///    * Informações apresentadas automaticamente no início.
  ///    * Nunca devem conter o diagnóstico final.
  dadosIniciais            Json
  /// *
  ///    * Informações que o servidor libera
  ///    * somente quando o usuário solicita.
  anamnese                 Json
  exameFisico              Json
  sinaisVitais             Json
  /// *
  ///    * Mantido para informações gerais do caso.
  ///    * Os exames solicitáveis individualmente ficam em ExameCaso.
  exames                   Json
  evolucao                 Json
  /// *
  ///    * Informações ocultas durante a investigação.
  diagnosticoFinal         String
  explicacaoDiagnostico    String
  diagnosticosDiferenciais Json
  pontosChave              Json
  /// *
  ///    * Configurações do caso.
  publicado                Boolean            @default(false)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  autorId                  Int
  geradoPorIA              Boolean            @default(false)
  autor                    Usuario            @relation(fields: [autorId], references: [id], onDelete: Cascade)
  examesCaso               ExameCaso[]
  investigacoes            InvestigacaoCaso[]

  @@index([area])
  @@index([dificuldade])
  @@index([publicado])
  @@index([autorId])
  @@index([geradoPorIA])
}

model ExameCaso {
  id            Int         @id @default(autoincrement())
  casoId        Int
  /// *
  ///    * Exemplo:
  ///    * Hemograma
  ///    * Gasometria arterial
  ///    * ECG
  ///    * Radiografia de tórax
  ///    * Troponina
  nome          String
  categoria     String?
  /// *
  ///    * O que o exame realmente mostrou.
  ///    * Fica no banco e NÃO é enviado antes de ser solicitado.
  resultado     String
  interpretacao String?
  /// *
  ///    * Ajuda o sistema a organizar a investigação.
  disponivel    Boolean     @default(true)
  ordem         Int         @default(0)
  createdAt     DateTime    @default(now())
  caso          CasoClinico @relation(fields: [casoId], references: [id], onDelete: Cascade)

  @@index([casoId])
  @@index([nome])
}

model InvestigacaoCaso {
  id                   Int                    @id @default(autoincrement())
  casoId               Int
  usuarioId            Int
  /// *
  ///    * EM_ANDAMENTO
  ///    * FINALIZADA
  status               String                 @default("EM_ANDAMENTO")
  /// *
  ///    * Guarda tudo que o aluno já descobriu.
  informacoesColetadas Json
  /// *
  ///    * Hipótese diagnóstica enviada pelo aluno.
  hipotese             String?
  /// *
  ///    * Raciocínio utilizado pelo aluno.
  justificativa        String?
  /// *
  ///    * Avaliação feita pelo sistema depois
  ///    * da hipótese final.
  avaliacao            Json?
  finalizado           Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  caso                 CasoClinico            @relation(fields: [casoId], references: [id], onDelete: Cascade)
  usuario              Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  registros            RegistroInvestigacao[]

  @@unique([casoId, usuarioId])
  @@index([usuarioId])
  @@index([casoId])
  @@index([status])
  @@index([finalizado])
}

model RegistroInvestigacao {
  id             Int              @id @default(autoincrement())
  investigacaoId Int
  /// *
  ///    * Exemplos:
  ///    * ANAMNESE
  ///    * EXAME_FISICO
  ///    * SINAL_VITAL
  ///    * EXAME
  ///    * EVOLUCAO
  ///    * HIPOTESE
  tipo           String
  titulo         String
  /// *
  ///    * Pergunta feita pelo usuário.
  ///    * Exemplo:
  ///    * "Quais são os antecedentes do paciente?"
  pergunta       String?
  /// *
  ///    * Resposta liberada pelo sistema.
  resposta       String
  /// *
  ///    * Ordem cronológica da investigação.
  ordem          Int
  createdAt      DateTime         @default(now())
  investigacao   InvestigacaoCaso @relation(fields: [investigacaoId], references: [id], onDelete: Cascade)

  @@index([investigacaoId])
  @@index([tipo])
}

model AppConfig {
  chave     String   @id
  valor     Json?
  updatedAt DateTime @updatedAt
}

enum TipoMovimentacao {
  RECEITA
  DESPESA
  DIVIDA
}


model AulaEstado {
  id                Int      @id @default(autoincrement())
  usuarioId         Int
  youtubeVideoId    String
  title             String
  channel           String?
  thumbnail         String?  @db.Text
  description       String?  @db.Text
  durationSeconds   Int?
  category          String?
  subjects          Json?
  progressSeconds   Int      @default(0)
  watchedSeconds    Int      @default(0)
  saved             Boolean  @default(false)
  completed         Boolean  @default(false)
  lastWatchedAt     DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  usuario           Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, youtubeVideoId])
  @@index([usuarioId, lastWatchedAt])
  @@index([usuarioId, saved])
  @@index([usuarioId, completed])
}

model AulaLista {
  id        Int             @id @default(autoincrement())
  nome      String
  usuarioId Int
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  itens     AulaListaItem[]

  @@index([usuarioId, updatedAt])
}

model AulaListaItem {
  id              Int       @id @default(autoincrement())
  listaId         Int
  youtubeVideoId  String
  title           String
  channel         String?
  thumbnail       String?   @db.Text
  durationSeconds Int?
  category        String?
  createdAt       DateTime  @default(now())
  lista           AulaLista @relation(fields: [listaId], references: [id], onDelete: Cascade)

  @@unique([listaId, youtubeVideoId])
  @@index([listaId, createdAt])
}

model AulaMeta {
  id        Int      @id @default(autoincrement())
  usuarioId Int      @unique
  tipo      String   @default("TIME")
  valor     Int      @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model AulaEstudoDiario {
  id               Int      @id @default(autoincrement())
  usuarioId        Int
  data             DateTime @db.Date
  seconds          Int      @default(0)
  lessonsCompleted Int      @default(0)
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, data])
  @@index([usuarioId, data])
}

model AulaNota {
  id               Int      @id @default(autoincrement())
  usuarioId        Int
  youtubeVideoId   String
  timestampSeconds Int      @default(0)
  conteudo         String   @db.Text
  createdAt        DateTime @default(now())
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, youtubeVideoId])
}

model AulaMarcador {
  id               Int      @id @default(autoincrement())
  usuarioId        Int
  youtubeVideoId   String
  timestampSeconds Int      @default(0)
  titulo           String
  createdAt        DateTime @default(now())
  usuario          Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, youtubeVideoId])
}
